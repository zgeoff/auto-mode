{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["hooks/**/*.ts", "contract/**/*.ts"],
  "exclude": ["contract/**/*.test.ts"]
}
