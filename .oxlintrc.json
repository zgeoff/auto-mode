{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./node_modules/@zgeoff/oxlint-config/oxlintrc.json"],
  "env": {
    "node": true,
    "es2024": true
  },
  "rules": {
    "typescript/prefer-readonly-parameter-types": [
      "error",
      {
        "ignoreInferredTypes": true,
        // the program table holds RegExp patterns, which no reader mutates
        "allow": [
          { "from": "lib", "name": "Buffer" },
          { "from": "lib", "name": "RegExp" },
          { "from": "package", "name": "Buffer", "package": "@types/node" }
        ]
      }
    ],

    // same set zgeoff/atc turns off, for the same reasons: each one fired only
    // where the code was already the clearest form available
    "import/max-dependencies": "off",
    "init-declarations": "off",
    "max-lines": "off",
    "max-lines-per-function": "off",
    "max-params": "off",
    "max-statements": "off",
    "no-await-in-loop": "off",
    "no-continue": "off",
    "no-inline-comments": "off",
    // zod schemas and jest-extended matchers are imported wholesale on purpose
    "import/no-namespace": "off",
    "promise/avoid-new": "off",
    "require-unicode-regexp": "off",

    // one-var wants consecutive `const` statements merged into one declaration,
    // which reads worse than what it replaces; sort-vars then wants the merged
    // declarators alphabetised. Both became reachable in oxlint 1.82
    "one-var": "off",
    "sort-vars": "off",

    "zgeoff/function-verb": ["error", { "verbs": ["classify", "record"], "exemptNames": ["main"] }],

    // the module boundaries: every file under src/ belongs to a zone, and a
    // new src/ folder joins one here, in the same PR that adds it. A known
    // violation carries a disable comment naming the ticket that removes it
    "zgeoff/import-zones": [
      "error",
      {
        "zones": {
          "core": ["src/**"],
          "mods": ["mods/**"],
          "orchestrator": [
            "src/classify-action.ts",
            "src/cli.ts",
            "src/eval/index.ts",
            "src/index.ts",
            "src/record-scope.ts",
            "src/run-cli.ts",
            "src/write-action-failure.ts"
          ],
          "request": ["src/request/**"],
          "support": [
            "src/{budget,capture,config,diagnostics,git,messages,policy,process,scope,secrets,shell,state}/**",
            "src/types.ts"
          ],
          "stage": ["src/{bypass,containment,judge,model,rules}/**"],
          "network": ["src/{messages,model}/**"],
          "process": ["src/process/**"],
          // the request and verdict shapes the mod and the CLI share
          "contract": ["mods/auto-mode/contract/**"],
          "mod": ["mods/auto-mode/**"],
          "tooling": ["{evals,scripts,test-utils,mocks,fixtures}/**"]
        },
        // the eval condition maps each export to source, which is what the zones judge
        "conditions": ["auto-mode-eval"],
        // source imports name the .ts file, as rewriteRelativeImportExtensions expects
        "extensions": [".ts"],
        "unzoned": [
          {
            "name": "zone-assignment",
            "from": ["core", "mods"],
            "zones": ["orchestrator", "request", "support", "stage", "contract", "mod"],
            "ignore": ["**/*.{test,bench,claude-check}.ts"]
          }
        ],
        "unresolved": [
          {
            "name": "unresolved",
            "from": ["core", "mods"],
            "ignore": ["**/*.{test,bench,claude-check}.ts"]
          }
        ],
        // a test may reach across the other boundaries, never between src/ and the mod
        "edges": [
          {
            "name": "src-mods-apart",
            "from": ["core"],
            "to": ["mods"],
            "allow": ["contract"],
            "reason": "src/ imports the mod"
          },
          {
            "name": "src-mods-apart",
            "from": ["mod"],
            "to": ["core"],
            "reason": "the mod ships as raw TypeScript and imports only itself"
          },
          {
            "name": "mod",
            "from": ["mod"],
            "allow": ["mod", "core"],
            "ignore": ["**/*.{test,bench,claude-check}.ts"],
            "reason": "the mod imports only itself"
          },
          {
            "name": "core-no-tooling",
            "from": ["core"],
            "to": ["tooling"],
            "ignore": ["**/*.{test,bench,claude-check}.ts"],
            "reason": "src/ imports eval, script or test code"
          },
          // contract, request, support and stages leave src/-to-mod and
          // src/-to-tooling edges to the two entries above
          {
            "name": "contract",
            "from": ["contract"],
            "to": ["mod"],
            "allow": ["contract"],
            "allowTypeOnly": ["**/types.ts"],
            "ignore": ["**/*.{test,bench,claude-check}.ts"],
            "reason": "the contract has no dependencies"
          },
          {
            "name": "request",
            "from": ["request"],
            "allow": ["request", "contract", "mods", "tooling"],
            "allowTypeOnly": ["**/types.ts"],
            "ignore": ["**/*.{test,bench,claude-check}.ts"]
          },
          {
            "name": "support",
            "from": ["support"],
            "allow": ["support", "contract", "mods", "tooling"],
            "allowTypeOnly": ["**/types.ts"],
            "ignore": ["**/*.{test,bench,claude-check}.ts"]
          },
          {
            "name": "stages",
            "from": ["stage"],
            "allow": ["support", "contract", "mods", "tooling"],
            "allowWithin": "src/*",
            "allowTypeOnly": ["**/types.ts"],
            "ignore": ["**/*.{test,bench,claude-check}.ts"],
            "reason": "a stage imports its own folder and the support modules"
          }
        ],
        "modules": [
          {
            "name": "network",
            "modules": ["node:http", "node:https", "node:http2"],
            "from": ["core", "mods"],
            "allow": ["network"],
            "allowTypeOnly": true,
            "ignore": ["**/*.{test,bench,claude-check}.ts"]
          },
          {
            "name": "child-process",
            "modules": ["node:child_process"],
            "from": ["core", "mods"],
            "allow": ["process"],
            "allowTypeOnly": true,
            "ignore": ["**/*.{test,bench,claude-check}.ts"]
          }
        ],
        "globals": [
          {
            "name": "network",
            "globals": ["fetch"],
            "from": ["core"],
            "allow": ["network"],
            "ignore": ["**/*.{test,bench,claude-check}.ts"]
          }
        ]
      }
    ]
  },
  "ignorePatterns": [".claude/**", ".reviews/**", ".worktrees/**"]
}
