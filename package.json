{
  "name": "auto-mode",
  "version": "3.1.1",
  "description": "A permission classifier library and Claude Code mod, so agents that are not Claude can run unattended",
  "keywords": [
    "agent",
    "claude-code",
    "mod",
    "permissions"
  ],
  "homepage": "https://github.com/zgeoff/auto-mode#readme",
  "bugs": "https://github.com/zgeoff/auto-mode/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zgeoff/auto-mode.git"
  },
  "bin": {
    "auto-mode": "./dist/cli.js"
  },
  "workspaces": [
    "evals"
  ],
  "files": [
    "dist",
    "policy",
    "mods/auto-mode",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "auto-mode-eval": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./eval": {
      "auto-mode-eval": "./src/eval/index.ts"
    },
    "./secret-rules.json": "./dist/secret-rules.json"
  },
  "scripts": {
    "audit": "bun audit",
    "bench": "bun --no-env-file src/secrets/find-secret.bench.ts",
    "build": "tsdown",
    "check": "bun run format:check && bun run lint:full && bun run typecheck && bun run deadcode && bun run test && bun run build && bun run check:artifact && bun run publint",
    "deadcode": "knip",
    "eval": "bun --no-env-file --conditions=auto-mode-eval evals/eval.ts",
    "eval:answer-guidance": "bun --no-env-file --conditions=auto-mode-eval evals/runners/run-answer-guidance-evaluation.ts",
    "eval:applicability": "bun --no-env-file --conditions=auto-mode-eval evals/runners/run-applicability-evaluation.ts",
    "eval:containment": "bun --no-env-file --conditions=auto-mode-eval evals/runners/run-containment-evaluation.ts",
    "eval:question-shape": "bun --no-env-file --conditions=auto-mode-eval evals/runners/run-question-shape-evaluation.ts",
    "eval:relay-consent": "bun --no-env-file --conditions=auto-mode-eval evals/runners/run-relay-consent-evaluation.ts",
    "eval:second-judge": "bun --no-env-file --conditions=auto-mode-eval evals/runners/run-second-judge-evaluation.ts",
    "eval:stale-consent": "bun --no-env-file --conditions=auto-mode-eval evals/runners/run-stale-consent-evaluation.ts",
    "format": "oxfmt . && format-codemod --quiet .",
    "format:check": "oxfmt --check . && format-codemod --check --quiet .",
    "lint": "oxlint",
    "lint:actionlint": "actionlint",
    "lint:fix": "oxlint --fix",
    "lint:full": "oxlint --type-aware --type-check --report-unused-disable-directives-severity error",
    "lint:shellcheck": "shellcheck scripts/*.sh .claude/skills/docs-writing/scripts/*.sh",
    "lint:shfmt": "shfmt -d scripts/*.sh",
    "prepare": "bash scripts/link-evals-package.sh && (command -v git > /dev/null 2>&1 && lefthook install --force || true)",
    "publint": "publint",
    "test": "bun run build && bun --no-env-file test --conditions=auto-mode-eval",
    "typecheck": "tsrs -p tsconfig.json --noEmit && tsrs -p evals/tsconfig.json --noEmit",
    "check:artifact": "bun --no-env-file scripts/check-artifact.ts",
    "check:claude-mod": "bun --no-env-file scripts/check-claude-mod.ts",
    "files:branch": "bun scripts/read-branch-files.ts",
    "lint:files": "oxlint --no-error-on-unmatched-pattern",
    "test:related": "bun scripts/run-related-tests.ts",
    "check:publish": "bun scripts/run-publish-check.ts",
    "release:merge": "bun scripts/run-release-merge.ts",
    "check:commits": "bun scripts/run-commits-check.ts",
    "check:local-paths": "bun scripts/run-local-paths-check.ts",
    "check:test-timeouts": "bun scripts/run-test-timeouts-check.ts",
    "check:workflows": "bun scripts/run-workflows-check.ts",
    "memory-capped": "bash scripts/run-memory-capped.sh \"$(bun scripts/read-memory-budget.ts)\""
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.303",
    "@commitlint/cli": "21.2.4",
    "@faker-js/faker": "10.6.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tsconfig/strictest": "2.0.8",
    "@types/bun": "1.4.3",
    "@types/node": "26.6.5",
    "@zgeoff/bun-test-extended": "0.2.1",
    "@zgeoff/format-codemod": "0.3.3",
    "@zgeoff/oxlint-config": "0.7.0",
    "@zgeoff/skill-gate": "0.2.9",
    "gunshi": "1.0.0-rc.1",
    "knip": "6.42.0",
    "lefthook": "2.2.2",
    "mitata": "1.0.34",
    "msw": "2.15.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "publint": "0.3.25",
    "re2js": "2.8.8",
    "tiny-invariant": "1.3.3",
    "ts-pattern": "5.9.2",
    "tsdown": "0.23.1",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "7.0.2",
    "zod": "4.6.7"
  },
  "overrides": {
    "smol-toml": "1.9.1"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.4.3"
}
