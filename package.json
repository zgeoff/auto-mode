{
  "name": "auto-mode",
  "version": "4.0.4",
  "description": "A permission classifier library and Claude Code mod, so agents that are not Claude can run unattended",
  "keywords": [
    "agent",
    "claude-code",
    "mod",
    "permissions"
  ],
  "homepage": "https://github.com/zgeoff/auto-mode#readme",
  "bugs": "https://github.com/zgeoff/auto-mode/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zgeoff/auto-mode.git"
  },
  "bin": {
    "auto-mode": "./dist/cli.js"
  },
  "files": [
    "dist",
    "policy",
    "mods/auto-mode",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "auto-mode-eval": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./eval": {
      "auto-mode-eval": "./src/eval/index.ts"
    },
    "./secret-rules.json": "./dist/secret-rules.json"
  },
  "scripts": {
    "audit": "bun audit --ignore=GHSA-g3hv-75wg-m249",
    "bench": "bun --no-env-file src/secrets/find-secret.bench.ts",
    "build": "tsdown",
    "check": "bun run format:check && bun run lint:full && bun run typecheck && bun run deadcode && bun run test && bun run build && bun run check:artifact && bun run publint",
    "deadcode": "bash scripts/run-knip.sh",
    "eval": "bun --no-env-file --conditions=auto-mode-eval scripts/run-experiments.ts",
    "eval:answer-guidance": "bun --no-env-file --conditions=auto-mode-eval evals/answer-guidance/run-answer-guidance-eval.ts",
    "eval:applicability": "bun --no-env-file --conditions=auto-mode-eval evals/applicability/run-applicability-eval.ts",
    "eval:containment": "bun --no-env-file --conditions=auto-mode-eval evals/containment/run-containment-eval.ts",
    "eval:question-shape": "bun --no-env-file --conditions=auto-mode-eval evals/question-severity/run-question-severity-eval.ts",
    "eval:relay-consent": "bun --no-env-file --conditions=auto-mode-eval evals/relay-consent/run-relay-consent-eval.ts",
    "eval:second-judge": "bun --no-env-file --conditions=auto-mode-eval evals/second-judge/run-second-judge-eval.ts",
    "eval:spawned-task": "bun --no-env-file --conditions=auto-mode-eval evals/spawned-task/run-spawned-task-eval.ts",
    "eval:stale-consent": "bun --no-env-file --conditions=auto-mode-eval evals/stale-consent/run-stale-consent-eval.ts",
    "format": "oxfmt . && format-codemod --quiet .",
    "format:check": "oxfmt --check . && format-codemod --check --quiet .",
    "lint": "oxlint",
    "lint:actionlint": "actionlint",
    "lint:fix": "oxlint --fix",
    "lint:full": "TSRS_FAST=1 oxlint --type-aware --type-check --report-unused-disable-directives-severity error",
    "lint:shellcheck": "shellcheck scripts/*.sh .agents/skills/docs-writing/scripts/*.sh",
    "lint:shfmt": "shfmt -d scripts/*.sh",
    "prepare": "command -v git > /dev/null 2>&1 && lefthook install --force || true",
    "publint": "publint",
    "test": "bun run build && BUN_OPTIONS='--no-env-file --conditions=auto-mode-eval' rig unit && bun run test:e2e",
    "test:e2e": "BUN_OPTIONS='--no-env-file --conditions=auto-mode-eval' rig e2e",
    "typecheck": "tsrs --fast -p tsconfig.json --noEmit",
    "check:artifact": "bun --no-env-file scripts/check-artifact.ts",
    "check:claude-mod": "bun --no-env-file scripts/check-claude-mod.ts",
    "test:related": "bun run build && BUN_OPTIONS='--no-env-file --conditions=auto-mode-eval' rig related",
    "check:publish": "bun scripts/run-publish-check.ts",
    "setup:ci-tools": "bun scripts/run-ci-tools-install.ts",
    "check:docs": "chex prose length links readmes skill"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.316",
    "@commitlint/cli": "21.2.4",
    "@faker-js/faker": "10.6.0",
    "@mswjs/interceptors": "0.45.11",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tsconfig/strictest": "2.0.8",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "@zgeoff/agent-hooks": "0.3.2",
    "@zgeoff/bun-test-extended": "0.2.4",
    "@zgeoff/chex": "0.4.7",
    "@zgeoff/diet": "0.3.2",
    "@zgeoff/format-codemod": "0.3.6",
    "@zgeoff/oxlint-config": "0.11.4",
    "@zgeoff/rig": "0.3.2",
    "@zgeoff/testing": "0.4.2",
    "gunshi": "1.0.0-rc.1",
    "knip": "6.44.1",
    "lefthook": "2.2.2",
    "mitata": "1.0.34",
    "msw": "3.0.4",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "publint": "0.3.25",
    "re2js": "2.10.0",
    "tiny-invariant": "1.3.3",
    "ts-pattern": "5.9.2",
    "tsdown": "0.23.4",
    "tsrs": "0.25.0-ts7.1.0-beta",
    "typescript": "7.1.0-dev.20261101.1",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.4.4"
}
