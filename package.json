{
  "name": "auto-mode",
  "version": "0.4.2",
  "description": "A permission classifier that runs as a hook, so agents that are not Claude can run unattended",
  "keywords": [
    "agent",
    "claude-code",
    "codex",
    "hook",
    "muse",
    "permissions"
  ],
  "homepage": "https://github.com/zgeoff/auto-mode#readme",
  "bugs": "https://github.com/zgeoff/auto-mode/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zgeoff/auto-mode.git"
  },
  "bin": {
    "auto-mode": "./dist/cli.js"
  },
  "files": [
    "dist",
    "policy",
    "mods/auto-mode",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./policy/classifier.md": "./policy/classifier.md",
    "./policy/rules.md": "./policy/rules.md"
  },
  "scripts": {
    "audit": "bun audit",
    "build": "tsdown",
    "build:agents": "bash scripts/build-agents-md.sh agents/shared.md agents/project.md AGENTS.md",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run deadcode && bun run test && bun run build && bun run check:artifact && bun run publint",
    "deadcode": "knip",
    "eval:answer-guidance": "bun --no-env-file scripts/run-answer-guidance-evaluation.ts",
    "eval:applicability": "bun --no-env-file scripts/run-applicability-evaluation.ts",
    "eval:question-shape": "bun --no-env-file scripts/run-question-shape-evaluation.ts",
    "eval:relay-consent": "bun --no-env-file scripts/run-relay-consent-evaluation.ts",
    "eval:stale-consent": "bun --no-env-file scripts/run-stale-consent-evaluation.ts",
    "first-publish": "scripts/first-publish.sh",
    "format": "oxfmt . && format-codemod --quiet .",
    "format:check": "oxfmt --check . && format-codemod --check --quiet .",
    "lint": "oxlint --type-aware --type-check --report-unused-disable-directives-severity error",
    "lint:fix": "oxlint --type-aware --type-check --report-unused-disable-directives-severity error --fix",
    "prepare": "command -v git > /dev/null 2>&1 && lefthook install --force || true",
    "publint": "publint",
    "test": "bun --no-env-file test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:artifact": "bun --no-env-file scripts/check-artifact.ts",
    "check:claude-mod": "bash scripts/check-claude-mod.sh"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@faker-js/faker": "10.6.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tsconfig/strictest": "2.0.8",
    "@types/bun": "1.3.14",
    "@types/node": "26.5.1",
    "@zgeoff/bun-test-extended": "0.1.0",
    "@zgeoff/format-codemod": "0.1.0",
    "@zgeoff/oxlint-config": "0.1.0",
    "knip": "6.35.1",
    "lefthook": "2.1.12",
    "msw": "2.15.0",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "publint": "0.3.24",
    "tiny-invariant": "1.3.3",
    "ts-pattern": "5.9.0",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "zod": "4.6.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.3.10"
}
