{
  "name": "auto-mode",
  "version": "0.1.0",
  "description": "A permission classifier that runs as a hook, so agents that are not Claude can run unattended",
  "keywords": [
    "agent",
    "hook",
    "permissions",
    "claude-code",
    "codex",
    "muse"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "auto-mode": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./policy/classifier.md": "./policy/classifier.md",
    "./policy/rules.md": "./policy/rules.md"
  },
  "files": [
    "dist",
    "policy",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "publint": "publint",
    "check": "npm run typecheck && npm run test && npm run build && npm run publint",
    "first-publish": "scripts/first-publish.sh"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "publint": "^0.3.24",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zgeoff/auto-mode.git"
  },
  "homepage": "https://github.com/zgeoff/auto-mode#readme",
  "bugs": "https://github.com/zgeoff/auto-mode/issues"
}
