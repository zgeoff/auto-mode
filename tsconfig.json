{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node", "bun", "@zgeoff/bun-test-extended"],
    "customConditions": ["auto-mode-eval"]
  },
  "include": [
    "src/**/*.ts",
    "e2e/**/*.ts",
    "evals/**/*.ts",
    "mods/auto-mode/hooks/**/*.ts",
    "mods/auto-mode/contract/**/*.ts",
    "scripts/**/*.ts",
    "rig.config.ts",
    "release-please-config.test.ts",
    "*.config.ts",
    "*.config.js"
  ],
  "exclude": ["node_modules", "dist", ".worktrees"]
}
