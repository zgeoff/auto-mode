{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node", "bun", "@zgeoff/bun-test-extended"]
  },
  "include": [
    "src/**/*.ts",
    "e2e/**/*.ts",
    "test-utils/**/*.ts",
    "mocks/**/*.ts",
    "mods/auto-mode/hooks/**/*.ts",
    "mods/auto-mode/contract/**/*.ts",
    "scripts/**/*.ts",
    "test-setup.ts",
    "*.config.ts",
    "*.config.js"
  ],
  "exclude": ["node_modules", "dist", ".worktrees", "evals"]
}
