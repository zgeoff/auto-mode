{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["gitleaks", "shellcheck", "shfmt", "actionlint", "mkfifo"],
  "ignoreIssues": {
    "mods/auto-mode/hooks/types.ts": ["types"]
  },
  "workspaces": {
    ".": {
      "entry": [
        "src/**/*.test.ts",
        "src/**/*.bench.ts",
        "e2e/**/*.test.ts",
        "evals/*/*.test.ts",
        "evals/*/run-*-eval.ts",
        "src/test-utils/run-stub-*.ts",
        "scripts/*.ts",
        "mods/auto-mode/hooks/register.ts",
        "mods/auto-mode/hooks/**/*.claude-check.ts",
        "mods/auto-mode/contract/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts",
        "e2e/**/*.ts",
        "evals/**/*.ts",
        "scripts/*.ts",
        "mods/auto-mode/hooks/**",
        "mods/auto-mode/contract/**"
      ],
      "ignoreDependencies": [
        "@stylistic/eslint-plugin",
        "@zgeoff/agent-hooks",
        "@zgeoff/diet",
        "claude-code"
      ]
    }
  }
}
