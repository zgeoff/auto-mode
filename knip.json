{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["gitleaks"],
  "workspaces": {
    ".": {
      "entry": [
        "src/**/*.test.ts",
        "src/**/*.bench.ts",
        "e2e/**/*.test.ts",
        "test-utils/**/*.test.ts",
        "test-utils/run-stub-*.ts",
        "mocks/**/*.test.ts"
      ],
      "project": ["src/**/*.ts", "e2e/**/*.ts", "test-utils/**/*.ts", "mocks/**/*.ts"],
      "ignoreDependencies": ["@stylistic/eslint-plugin", "@zgeoff/oxlint-config"]
    },
    "evals": {
      "entry": ["**/*.test.ts", "runners/*.ts", "eval.ts"],
      "project": ["**/*.ts"]
    }
  }
}
