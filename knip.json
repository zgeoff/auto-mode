{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["gitleaks", "shellcheck", "shfmt", "actionlint"],
  "ignoreIssues": {
    "mods/auto-mode/hooks/types.ts": ["types"]
  },
  "workspaces": {
    ".": {
      "entry": [
        "src/**/*.test.ts",
        "src/**/*.bench.ts",
        "e2e/**/*.test.ts",
        "test-utils/**/*.test.ts",
        "test-utils/run-stub-*.ts",
        "mocks/**/*.test.ts",
        "scripts/*.ts",
        "mods/auto-mode/hooks/register.ts",
        "mods/auto-mode/hooks/**/*.claude-check.ts",
        "mods/auto-mode/contract/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts",
        "e2e/**/*.ts",
        "test-utils/**/*.ts",
        "mocks/**/*.ts",
        "scripts/*.ts",
        "mods/auto-mode/hooks/**",
        "mods/auto-mode/contract/**"
      ],
      "ignoreDependencies": ["@stylistic/eslint-plugin", "@zgeoff/oxlint-config", "claude-code"]
    },
    "evals": {
      "entry": ["**/*.test.ts", "runners/*.ts", "eval.ts"],
      "project": ["**/*.ts"]
    }
  }
}
