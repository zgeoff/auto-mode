{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "src/**/*.test.ts",
        "src/**/*.bench.ts",
        "src/eval/index.ts",
        "e2e/**/*.test.ts",
        "test-utils/**/*.test.ts",
        "test-utils/run-stub-*.ts",
        "scripts/**/*.test.ts",
        "mocks/**/*.test.ts",
        "test-setup.ts"
      ],
      "project": ["src/**/*.ts", "e2e/**/*.ts", "test-utils/**/*.ts", "mocks/**/*.ts"],
      "ignoreDependencies": ["@stylistic/eslint-plugin", "@zgeoff/oxlint-config"]
    },
    "evals": {
      "entry": ["**/*.test.ts", "runners/*.ts"],
      "project": ["**/*.ts"],
      "ignoreDependencies": ["auto-mode"]
    }
  }
}
